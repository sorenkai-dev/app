<configuration>
    <conversionRule conversionWord="sanmsg" converterClass="com.sorenkai.api.logging.SanitizingMessageConverter"/>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{YYYY-MM-dd HH:mm:ss.SSS} [%thread] reqId=%X{X-Request-ID} uid=%X{uid} method=%X{method} path=%X{path} status=%X{status} %-5level %logger{36} - %sanmsg%n</pattern>
        </encoder>
    </appender>
    <root level="DEBUG">
        <appender-ref ref="STDOUT"/>
    </root>
    <logger name="org.eclipse.jetty" level="INFO"/>
    <logger name="io.netty" level="INFO"/>
</configuration>
